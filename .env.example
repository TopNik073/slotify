DEBUG=true

JWT_SECRET=change-me-to-a-long-random-string

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=slotify

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Yandex Cloud Postbox, used for 2FA codes and participant invitations.
YC_POSTBOX_ACCESS_KEY=
YC_POSTBOX_SECRET_KEY=
YC_POSTBOX_REGION=ru-central1
YC_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
MAIL_FROM=no-reply@example.com

# Fernet key for encrypting Google OAuth tokens at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Google OAuth client: Google Cloud Console -> APIs & Services -> Credentials ->
# Create OAuth client ID -> Web application. Enable the Google Calendar API for the project
# and add the redirect URI below to the client's "Authorized redirect URIs".
GOOGLE_CREDENTIALS__CLIENT_ID=
GOOGLE_CREDENTIALS__CLIENT_SECRET=
GOOGLE_CREDENTIALS__REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
